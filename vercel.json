{
    "version": 2,
    "builds": [
        {
            "src": "api/rpc-bridge.js",
            "use": "@vercel/node"
        },
        {
            "src": "frontend/(.*)",
            "use": "@vercel/static"
        }
    ],
    "rewrites": [
        {
            "source": "/api/rpc-bridge",
            "destination": "api/rpc-bridge.js"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/$1"
        }
    ]
}